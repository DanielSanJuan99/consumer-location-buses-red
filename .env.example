# ============================================
# Variables de Entorno - Consumer Location Buses RED
# ============================================
# Copia este archivo como .env y ajusta los valores según tu entorno.
# Uso: docker run --env-file .env ...
#      o exportar manualmente: export $(cat .env | xargs)

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VIRTUAL_HOST=/

# ============================================
# ORACLE DATABASE
# ============================================
# Servicio Oracle (debe coincidir con tnsnames.ora del Wallet)
ORACLE_SERVICE_NAME=bdbusesred_high

# Credenciales de Oracle
ORACLE_USERNAME=ADMIN
ORACLE_PASSWORD=tu_password_oracle

# Ruta del Wallet dentro del contenedor (no cambiar si usas Docker)
WALLET_PATH=/app/wallet

# ============================================
# POOL DE CONEXIONES (HikariCP)
# ============================================
DB_MAX_POOL_SIZE=3
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ============================================
# NOTAS
# ============================================
# 1. NO commitees el archivo .env (solo .env.example)
# 2. ORACLE_PASSWORD es OBLIGATORIO y no tiene valor por defecto
# 3. El Wallet debe montarse como volumen: ./Wallet:/app/wallet:ro
# 4. Los archivos sqlnet.ora y ojdbc.properties del Wallet deben
#    tener las rutas apuntando a /app/wallet
# 5. En EC2, la carpeta Wallet necesita permisos: chmod 777 ~/Wallet
